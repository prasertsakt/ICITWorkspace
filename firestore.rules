rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is signed in with Google Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Helper: Get the current user's email normalized to lowercase
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Helper: Check if requester is registered as an Active Admin
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/personnel/$(request.auth.uid)) ||
        userEmail() == "prasertsak.t@cit.kmutnb.ac.th" ||
        userEmail() == "tiawongsombat@gmail.com" ||
        userEmail() == "jarucha.j@icit.kmutnb.ac.th"
      );
    }

    // Helper: Check if requester is HR Officer (Jarucha) or Admin
    function isHrOrAdmin() {
      return isAuthenticated() && (
        isAdmin() ||
        userEmail() == "jarucha.j@icit.kmutnb.ac.th" ||
        userEmail() == "prasertsak.t@cit.kmutnb.ac.th" ||
        userEmail() == "tiawongsombat@gmail.com"
      );
    }

    // 1. Rules for 'personnel' collection (Whitelist & Personnel Records)
    match /personnel/{personId} {
      // Anyone (including guests) can read personnel directory to view live organization structure
      allow read: if true;
      // Write (Create, Update, Delete) is restricted to authenticated users / admins
      allow write: if isAuthenticated();
    }

    // 2. Rules for 'departments' collection
    match /departments/{deptId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 3. Rules for 'executives' collection
    match /executives/{execId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 4. Rules for 'leaves' collection (Leave Calendar Records)
    match /leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 5. Rules for 'leaves_archive' collection (Archived Historical Leave Records)
    match /leaves_archive/{archiveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 6. Rules for 'time_attendances' collection (Time Attendance Requests)
    match /time_attendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 7. Rules for 'job_descriptions' collection (JD Hub)
    match /job_descriptions/{jdId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.personnelEmail == userEmail() ||
        request.resource.data.personnelEmail == userEmail()
      );
      allow delete: if isAdmin();
    }

    // 8. Rules for 'email_logs' collection (Sent Email History & Logs)
    match /email_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 9. Rules for 'activity_logs' collection (System Audit & Activity Logs)
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // 10. Rules for 'settings' collection (Portal Configurations, JD Hub Config, etc.)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 11. Rules for 'ims_audits' collection (Internal Audit Reports)
    match /ims_audits/{auditId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 12. Rules for 'ims_config' collection (Yearly Lead & Internal Auditor Assignments)
    match /ims_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 13. Rules for 'ims_car_incidents' collection (CAR & Incident Hub - ICIT-FM-COMMON-013)
    match /ims_car_incidents/{carId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated() && resource.data.status != "CLOSED";
    }

    // 14. Rules for 'ims_ofi_hub' collection (OFI Hub - Opportunity for Improvement)
    match /ims_ofi_hub/{ofiId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 15. Rules for 'idp_records' collection (IDP Hub - Individual Development Plan & Need Analysis)
    match /idp_records/{idpId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isHrOrAdmin();
    }

    // 16. Rules for 'idp_config' collection (IDP Master Competency Configuration per Fiscal Year)
    match /idp_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isHrOrAdmin();
    }

    // 17. Rules for 'idp_strategy_config' collection (IDP Strategic Framework: Vision, SFA, SO, CKPI)
    match /idp_strategy_config/{configId} {
      allow read: if isAuthenticated();
      allow write: if isHrOrAdmin();
    }

    // 18. Rules for 'idp_action_plans' collection (IDP Action Plans & Quarterly Progress Tracking)
    match /idp_action_plans/{planId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isHrOrAdmin();
    }

    // 19. Rules for 'skill_map_configs' collection (Knowledge & Skill Map Master Hierarchy)
    match /skill_map_configs/{configId} {
      allow read: if isAuthenticated();
      allow write: if isHrOrAdmin();
    }

    // 20. Rules for 'skill_map_assessments' collection (Personnel Skill Map Assessments)
    match /skill_map_assessments/{assessmentId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isHrOrAdmin();
    }

    // 21. Rules for 'tqa_ofi_items' collection (Thailand Quality Award - TQA OFI Tracking)
    match /tqa_ofi_items/{ofiId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // 22. Rules for 'tqa_reports' collection (TQA Feedback Report URLs per Fiscal Year)
    match /tqa_reports/{reportId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // 23. Rules for 'km_records' collection (Knowledge Management & Tracking Hub)
    match /km_records/{kmId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }
  }
}
