rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is signed in with Google Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Helper: Get the current user's email normalized to lowercase
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Helper: Check if requester is registered as an Active Admin in personnel collection
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/personnel/$(request.auth.uid)) ||
        // Check if any personnel document matches the user email with Admin role
        request.auth.token.email == "prasertsak.t@cit.kmutnb.ac.th" ||
        request.auth.token.email == "tiawongsombat@gmail.com" ||
        request.auth.token.email == "jarucha.j@icit.kmutnb.ac.th"
      );
    }

    // Rules for 'personnel' collection (Whitelist & Personnel Records)
    match /personnel/{personId} {
      // Anyone (including guests) can read personnel directory to view live organization structure
      allow read: if true;

      // Write (Create, Update, Delete) is strictly restricted to authenticated users / admins:
      allow write: if isAuthenticated();
    }

    // Rules for 'departments' collection
    match /departments/{deptId} {
      // Anyone can read department structure
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for 'executives' collection
    match /executives/{execId} {
      // Anyone can read executive directory
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for 'leaves' collection (Leave Calendar Records)
    match /leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'leaves_archive' collection (Archived Historical Leave Records)
    match /leaves_archive/{archiveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'time_attendances' collection (Time Attendance Requests)
    match /time_attendances/{attendanceId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'job_descriptions' collection (JD Hub)
    match /job_descriptions/{jdId} {
      // Must be logged in to view JDs
      allow read: if isAuthenticated();

      // Create: Authenticated users/admins
      allow create: if isAuthenticated();

      // Update: Admin can update any JD; Owner can update their own JD
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.personnelEmail == userEmail() ||
        request.resource.data.personnelEmail == userEmail()
      );

      // Delete: Only Admin can delete (User cannot delete)
      allow delete: if isAdmin();
    }

    // Rules for 'email_logs' collection (Sent Email History & Logs)
    match /email_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'activity_logs' collection (System Audit & Activity Logs)
    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'settings' collection (Portal Configurations, Service Order, JD Config, etc.)
    match /settings/{settingId} {
      allow read: if true; // Any visitor can read portal card order & public configs
      allow write: if isAuthenticated(); // Only logged-in users / admins can save
    }

    // Rules for 'ims_audits' collection (Integrated Management System - Internal Audit Reports)
    match /ims_audits/{auditId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for 'ims_config' collection (Yearly Lead & Internal Auditor Assignments)
    match /ims_config/{configId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Rules for 'ims_car_incidents' collection (CAR & Incident Hub - ICIT-FM-COMMON-013)
    match /ims_car_incidents/{carId} {
      // All visitors and staff can view CAR & Incident records
      allow read: if true;

      // Authenticated users can create new CAR/Incident drafts
      allow create: if isAuthenticated();

      // Authenticated users (Requesters, Requestees, DCC, Admin) can update
      allow update: if isAuthenticated();

      // Deletion rule: Must be authenticated AND status must NOT be 'CLOSED'
      // Closed records are permanently locked against deletion at the database level
      allow delete: if isAuthenticated() && (
        resource.data.status != "CLOSED"
      );
    }

    // Rules for 'ims_ofi_hub' collection (OFI Hub - Opportunity for Improvement)
    match /ims_ofi_hub/{ofiId} {
      // All staff and authenticated visitors can view OFI records
      allow read: if true;

      // Authenticated users (DCC, MR, Assignees, Admin) can create and update OFI items
      allow create, update: if isAuthenticated();

      // Authenticated users (DCC, Admin) can delete OFI records
      allow delete: if isAuthenticated();
    }
  }
}
