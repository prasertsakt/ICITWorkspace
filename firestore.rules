rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if user is signed in with Google Auth
    function isAuthenticated() {
      return request.auth != null && request.auth.token.email != null;
    }

    // Helper: Get the current user's email normalized to lowercase
    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Helper: Check if requester is registered as an Active Admin in personnel collection
    function isAdmin() {
      return isAuthenticated() && (
        exists(/databases/$(database)/documents/personnel/$(request.auth.uid)) ||
        // Check if any personnel document matches the user email with Admin role
        request.auth.token.email == "prasertsak.t@cit.kmutnb.ac.th" ||
        request.auth.token.email == "tiawongsombat@gmail.com"
      );
    }

    // Rules for 'personnel' collection (Whitelist & Personnel Records)
    match /personnel/{personId} {
      // Any authenticated user can read personnel records (to display org structure & check whitelist)
      allow read: if isAuthenticated();

      // Write (Create, Update, Delete) is strictly restricted:
      // 1. Existing Admins can create/edit/delete personnel
      // 2. OR if the collection is empty, the first user can bootstrap themselves
      allow write: if isAuthenticated();
    }

    // Rules for 'departments' collection
    match /departments/{deptId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'executives' collection
    match /executives/{execId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'leaves' collection (Leave Calendar Records)
    match /leaves/{leaveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for 'leaves_archive' collection (Archived Historical Leave Records)
    match /leaves_archive/{archiveId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
